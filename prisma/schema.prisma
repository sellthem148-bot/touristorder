// Les montants sont en AGOROT (centimes de shekel) : 12,90 ₪ = 1290.
// Jamais de Float pour de l'argent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Categorie {
  id        String    @id @default(cuid())
  nom       String    @unique
  slug      String    @unique
  emoji     String    @default("🛍️")
  ordre     Int       @default(0)
  active    Boolean   @default(true)
  produits  Produit[]
  createdAt DateTime  @default(now())
}

model Produit {
  id          String          @id @default(cuid())
  nom         String
  description String          @default("")
  prix        Int // prix de vente au client, en agorot ; 0 = « à définir » : jamais visible ni commandable
  photoUrl    String          @default("")
  actif       Boolean         @default(true)
  // Visible dans le catalogue mais impossible à commander (rupture passagère).
  epuise      Boolean         @default(false)
  // "" | "populaire" | "nouveau" | "promo"
  badge       String          @default("")
  // Ancien prix affiché barré (promo). Toujours supérieur à `prix`.
  prixBarre   Int?
  // Variantes : [{ nom: "Taille", choix: [{ libelle: "4 ans", supplement: 0 }] }]
  // Le client choisit une valeur par groupe. Lu et validé par lib/options.ts.
  options     Json            @default("[]")
  ordre       Int             @default(0)
  categorieId String
  categorie   Categorie       @relation(fields: [categorieId], references: [id], onDelete: Restrict)

  // Réservé à l'admin : jamais lu par une page publique.
  prixAchat   Int? // ce que l'article te coûte sur Wolt, en agorot
  boutique    String          @default("") // où le commander (ex. « Wolt Market Dizengoff »)
  lienWolt    String          @default("")

  lignes      LigneCommande[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categorieId])
}

enum StatutCommande {
  RECUE
  COMMANDEE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

model Commande {
  id             String          @id @default(cuid())
  numero         Int             @unique @default(autoincrement())
  jeton          String          @unique // lien de suivi du client
  statut         StatutCommande  @default(RECUE)

  nomClient      String
  telephone      String
  ville          String
  adresse        String
  dateLivraison  String // AAAA-MM-JJ, jour israélien
  creneau        String
  notes          String          @default("")
  express        Boolean         @default(false)
  // Si un article manque : CONTACTER | EQUIVALENT | RETIRER
  remplacement   String          @default("CONTACTER")
  paiement       String          @default("")

  sousTotal      Int
  fraisService   Int
  fraisLivraison Int
  pourboire      Int             @default(0)
  total          Int
  // Les frais en vigueur au moment de la commande : si tu retires des
  // articles puis les remets, les frais reviennent à ce montant.
  tarifService   Int
  tarifLivraison Int // express compris
  tarifPourboire Int             @default(0)
  supplementVille Int            @default(0) // supplément de livraison de la ville, compris dans fraisLivraison
  // Le tarif du moment de la livraison (journée, nuit, week-end…), copié à la commande.
  tarifNom       String          @default("")
  majorationPct  Int             @default(0) // % ajouté aux articles par ce tarif
  majoration     Int             @default(0) // son montant, en agorot

  noteInterne    String          @default("")
  lignes         LigneCommande[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([statut, createdAt])
}

// Une ligne garde une copie du produit au moment de la commande :
// modifier ou supprimer un produit ne change pas les commandes passées.
model LigneCommande {
  id                String   @id @default(cuid())
  commandeId        String
  commande          Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produitId         String?
  produit           Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)
  nom               String
  options           String   @default("") // « Taille : 4 ans · Couleur : bleu »
  prixUnitaire      Int // options comprises
  prixAchatUnitaire Int?
  boutique          String   @default("")
  lienWolt          String   @default("")
  quantite          Int
  indisponible      Boolean  @default(false)

  @@index([commandeId])
  @@index([produitId])
}

// Une seule ligne (id = 1).
model Reglages {
  id              Int      @id @default(1)
  fraisService    Int      @default(1500)
  fraisLivraison  Int      @default(3000)
  fraisExpress    Int      @default(0) // supplément livraison express ; 0 = pas d'express
  pourboires      Int[]    @default([0, 1000, 1500, 2000]) // montants proposés ; vide = pas de pourboire
  paiements       String[] @default(["Espèces", "Bit", "PayBox"])
  minimumCommande Int      @default(0)
  creneaux        String[] @default([])
  joursLivres     Int[]    @default([0, 1, 2, 3, 4, 5, 6]) // 0 = dimanche … 6 = samedi
  // Commande jusqu'à cette heure (« HH:MM ») pour être livrée le soir même ; vide = pas d'heure limite.
  // Le gérant reçoit les articles par Wolt dans la journée, puis livre le soir.
  heureLimite     String   @default("17:00")
  delaiPreparation Int     @default(60) // minutes entre la commande et le début du créneau (commande sur Wolt + reconditionnement)
  whatsapp        String   @default("") // ton numéro, format international sans + (ex. 972501234567)
  messageAccueil  String   @default("")
  ouvert          Boolean  @default(true)
  // Afficher au client une seule ligne « Frais de service (livraison comprise) ».
  fraisRegroupes  Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// Un tarif selon le moment de la livraison (nuit, week-end…). La première plage
// active (par ordre) qui contient le moment s'applique ; sinon, le tarif de base
// des Réglages. Lu et vérifié par lib/tarifs.ts.
model PlageTarifaire {
  id             String   @id @default(cuid())
  nom            String
  jours          Int[] // 0 = dimanche … 6 = samedi
  debut          String // « HH:MM », heure d'Israël
  fin            String // « HH:MM » ; fin < début = passe minuit ; fin = début = toute la journée
  fraisService   Int
  fraisLivraison Int
  fraisExpress   Int // 0 = pas d'express pendant cette plage
  majorationPct  Int      @default(0) // % ajouté aux articles (0 = prix normaux)
  ordre          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// Une ville livrée. La livraison = livraison du tarif du moment + supplément de la ville.
model Ville {
  id                  String   @id @default(cuid())
  nom                 String   @unique
  supplementLivraison Int      @default(0) // en agorot, ajouté à la livraison
  minimumCommande     Int      @default(0) // minimum d'articles pour cette ville (0 = celui des Réglages)
  active              Boolean  @default(true)
  ordre               Int      @default(0)
  createdAt           DateTime @default(now())
}
