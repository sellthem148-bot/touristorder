# Base de données.
# - En local : PostgreSQL sur ta machine (les deux lignes ci-dessous).
# - Sur Vercel : ne rien poser. La base Supabase créée depuis Vercel (Storage → Supabase) fournit
#   toute seule POSTGRES_PRISMA_URL et POSTGRES_URL_NON_POOLING, que le site lit (lib/adresses-base.ts).
# - Base Supabase créée à la main : DATABASE_URL = « Transaction pooler » (port 6543),
#   DIRECT_URL = « Session pooler » (port 5432).
DATABASE_URL="postgresql://livraison:livraison@localhost:5432/livraison"
DIRECT_URL="postgresql://livraison:livraison@localhost:5432/livraison"

# Espace admin : ton mot de passe (8 caractères au moins), et la clé qui signe les sessions
# (openssl rand -base64 48 ; changer la clé déconnecte tout le monde). Sur Vercel avec la base
# Supabase créée depuis Vercel, SESSION_SECRET est facultative : le site en dérive une tout seul.
ADMIN_PASSWORD="change-moi"
SESSION_SECRET="remplace-par-une-longue-cle-aleatoire-de-48-caracteres-minimum"

# Photos produits. Sur Vercel avec la base Supabase créée depuis Vercel : ne rien poser
# (SUPABASE_URL et SUPABASE_SECRET_KEY arrivent tout seuls). Sans Supabase, les photos
# sont enregistrées dans public/uploads (en local seulement).
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="produits"

# Le nom affiché du site.
NEXT_PUBLIC_NOM_DU_SITE="Tourist Order"

# E-mails (confirmation de commande, lien de connexion à l'espace client, avis au gérant).
# Compte Resend (resend.com) : crée une clé API, vérifie ton nom de domaine, puis :
RESEND_API_KEY=""
# L'expéditeur, sur ton domaine vérifié chez Resend.
EMAIL_EXPEDITEUR="Tourist Order <commandes@touristorder.com>"
# Ton adresse : tu reçois un e-mail à chaque nouvelle commande (vide = pas d'avis).
EMAIL_GERANT=""
# L'adresse publique du site, pour les liens des e-mails (https://touristorder.com une fois le domaine branché).
NEXT_PUBLIC_SITE_URL=""
