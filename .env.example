# Base de données (Supabase → Project Settings → Database → Connection string)
# DATABASE_URL : le « Transaction pooler » (port 6543) avec ?pgbouncer=true — pour Vercel.
# DIRECT_URL   : le « Session pooler » ou la connexion directe (port 5432) — pour `prisma db push`.
DATABASE_URL="postgresql://livraison:livraison@localhost:5432/livraison"
DIRECT_URL="postgresql://livraison:livraison@localhost:5432/livraison"

# Espace admin : ton mot de passe, et une clé secrète longue et aléatoire
# (openssl rand -base64 48). Changer la clé déconnecte l'admin.
ADMIN_PASSWORD="change-moi"
SESSION_SECRET="remplace-par-une-longue-cle-aleatoire-de-48-caracteres-minimum"

# Photos produits (Supabase → Project Settings → API). Sans ces deux variables,
# les photos sont enregistrées dans public/uploads (en local seulement).
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="produits"

# Le nom affiché du site (en attendant le vrai nom).
NEXT_PUBLIC_NOM_DU_SITE="Courses Express"

# E-mails (confirmation de commande, lien de connexion à l'espace client, avis au gérant).
# Compte Resend (resend.com) : crée une clé API, vérifie ton nom de domaine, puis :
RESEND_API_KEY=""
# L'expéditeur, sur ton domaine vérifié chez Resend.
EMAIL_EXPEDITEUR="Courses Express <commandes@ton-domaine.com>"
# Ton adresse : tu reçois un e-mail à chaque nouvelle commande (vide = pas d'avis).
EMAIL_GERANT=""
# L'adresse publique du site, pour les liens des e-mails (ex. https://ton-domaine.com).
NEXT_PUBLIC_SITE_URL=""
